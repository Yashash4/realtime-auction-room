# Supabase project (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only: used by the daily cron sweep (/api/cron/resolve) to resolve
# expired items in abandoned rooms. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Shared secret guarding /api/cron/resolve. Vercel Cron sends it as a Bearer token.
CRON_SECRET=generate-a-long-random-string
